{
  "name": "PS XMB",
  "author": "erickramoscruz",
  "version": "v1.19",
  "target": "System-Wide",
  "manifest_version": 9,
  "description": "Elige tu consola: PS2 (anillo de luces), PS3 (XMB en columna), PS4 (Flow o particulas), PS5 (simbolos) o Steam Deck; cada una trae su fondo animado, sus tarjetas y su color. Pagina de juego a pantalla completa (idea de Clean Gameview, MIT). Opcional: portadas de SteamGridDB (portadas/LEEME.txt), sonidos que cambian con la consola (sonidos/LEEME.txt) y controles arriba/abajo para la columna de PS3 (controles/LEEME.txt).",
  "inject": {
    "shared.css": [
      "SP",
      "QuickAccess",
      "MainMenu"
    ],
    "fondo.css": [
      "SP"
    ],
    "menus.css": [
      "QuickAccess",
      "MainMenu"
    ],
    "acentos.css": [
      "SP",
      "QuickAccess",
      "MainMenu"
    ],
    "extras/inicio-ps4.css": [
      "SP"
    ]
  },
  "patches": {
    "Consola": {
      "default": "PS4 (Flow)",
      "type": "dropdown",
      "values": {
        "PS2": {
          "extras/tarjetas-ps4.css": [
            "SP"
          ],
          "extras/tarjetas-ps2.css": [
            "SP"
          ],
          "fondos/orbes-ps2.css": [
            "SP"
          ],
          "colores/ps2.css": [
            "SP",
            "QuickAccess",
            "MainMenu"
          ]
        },
        "PS3": {
          "extras/tarjetas-ps4.css": [
            "SP"
          ],
          "extras/tarjetas-ps3.css": [
            "SP"
          ],
          "fondos/ola-ps3.css": [
            "SP"
          ],
          "colores/clasico.css": [
            "SP",
            "QuickAccess",
            "MainMenu"
          ],
          "extras/fondo-juego.css": [
            "SP"
          ]
        },
        "PS4 (Flow)": {
          "extras/tarjetas-ps4.css": [
            "SP"
          ],
          "fondos/ondas-ps4.css": [
            "SP"
          ],
          "colores/ps4.css": [
            "SP",
            "QuickAccess",
            "MainMenu"
