            "SP"
          ],
          "fondos/simbolos-ps5.css": [
            "SP"
          ],
          "colores/ps5.css": [
            "SP",
            "QuickAccess",
            "MainMenu"
          ],
          "extras/fondo-juego.css": [
            "SP"
          ]
